# Service systemd utilisateur (optionnel) : lance LIFE RPG avec ta session.
# Installation :
#   mkdir -p ~/.config/systemd/user
#   sed "s|@REPO@|$PWD|" scripts/life-rpg.service > ~/.config/systemd/user/life-rpg.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now life-rpg.service
# Lance d'abord « make build » une fois : le service ne reconstruit pas le front.
[Unit]
Description=LIFE RPG (serveur local sur 127.0.0.1:8000)
After=default.target

[Service]
Type=simple
WorkingDirectory=@REPO@/backend
ExecStartPre=%h/.local/bin/uv run python manage.py migrate --noinput
ExecStart=%h/.local/bin/uv run python manage.py runserver 127.0.0.1:8000 --noreload
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
