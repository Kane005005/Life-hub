# Copie ce fichier en .env (make env le fait pour toi, avec une clé neuve).
# Ne mets jamais .env dans le dépôt.

# Clé secrète Django (obligatoire, longue et aléatoire)
LIFE_RPG_SECRET_KEY=a-remplacer

# Mode debug (True en développement local)
LIFE_RPG_DEBUG=True

# Fuseau horaire utilisé pour les journées (ex. Africa/Bamako, Europe/Paris)
LIFE_RPG_TIME_ZONE=UTC

# Chemin de la base SQLite (défaut : data/life_rpg.sqlite3 à la racine du dépôt)
# LIFE_RPG_DB_PATH=/home/<toi>/life-rpg-data/life_rpg.sqlite3

# Dossier des sauvegardes (défaut : backups/ à la racine du dépôt)
# LIFE_RPG_BACKUP_DIR=/home/<toi>/life-rpg-backups
